# Образец окружения. Реальных значений здесь нет и быть не может — файл лежит в репозитории.
# Скопируй в .env и заполни. Пустое значение = берётся дефолт, указанный в комментарии.
# Всё окружение читается ровно в одном месте — src/config.js.

# ── Сервер ────────────────────────────────────────────────────────────────────
# Порт HTTP-сервера. Дефолт: 3000. Нечисловое значение логируется и заменяется дефолтом.
PORT=
# Метка сборки, видна в /health. Дефолт: dev.
BUILD_TAG=
# Предел размера тела запроса в байтах. Дефолт: 1048576 (1 МБ).
MAX_REQUEST_BODY_BYTES=

# ── Вход ──────────────────────────────────────────────────────────────────────
# Путь к файлу сотрудников и сессий. ОТДЕЛЬНО от снимка намеренно: снимок целиком
# заменяется при каждой синхронизации, и учётные записи стирались бы вместе с ним.
# Дефолт: data/users.json.
USERS_FILE=
# Ставить ли флаг Secure на куку сессии. За HTTPS (боевой режим, см. DEPLOY.md) —
# обязательно включить (1). На голом HTTP с этим флагом кука не сохранится вовсе,
# и вход сломается — поэтому по умолчанию выключено (0), для локального запуска.
COOKIE_SECURE=

# ── Данные ────────────────────────────────────────────────────────────────────
# Источник снимка: demo (детерминированный генератор) | bitrix (реальный портал). Дефолт: demo.
DATA_SOURCE=
# Часовой пояс портала — в нём считаются границы периодов. Дефолт: Europe/Moscow.
# Неизвестное имя пояса логируется и заменяется дефолтом.
PORTAL_TIMEZONE=
# Путь к файлу аналитического снимка. Относительный — от корня проекта,
# абсолютный (persistent-том) используется как есть. Дефолт: data/snapshot.json.
SNAPSHOT_FILE=
# Зерно генератора демо-данных: одно зерно — один и тот же снимок. Дефолт: 20260815.
DEMO_SEED=

# ── Синхронизация ─────────────────────────────────────────────────────────────
# Автоматическая синхронизация: 1 включена, 0 выключена. Дефолт: 1.
SYNC_ENABLED=
# Период автоматической синхронизации в мс. Дефолт: 600000 (10 минут).
SYNC_INTERVAL_MS=
# Через сколько мс снимок считается устаревшим и помечается в интерфейсе. Дефолт: 1800000 (30 минут).
SNAPSHOT_STALE_AFTER_MS=

# ── Битрикс24 (нужны только при DATA_SOURCE=bitrix) ───────────────────────────
# Ключ API. Живёт только на сервере, в браузер не уходит никогда. Без него DATA_SOURCE=bitrix
# помечает конфигурацию деградированной, а /ready отвечает 503.
BITRIX_API_KEY=
# База API VibeCode. Дефолт: https://vibecode.bitrix24.tech/v1
BITRIX_API_BASE=
# Адрес портала — из него собираются ссылки на карточки компаний и сделок.
# Дефолт: https://example.bitrix24.ru (заглушка, заменить на портал заказчика).
BITRIX_PORTAL_URL=
# Таймаут одного запроса к порталу в мс. Дефолт: 20000.
BITRIX_TIMEOUT_MS=
# На сколько лет назад забирать компании и сделки. «Вся история выбранных баз»
# в Статике не должна упираться в произвольно короткую глубину. Дефолт: 4.
BITRIX_HISTORY_YEARS=
# Ширина временного окна выборки в днях: меньше окно — меньше сущностей в одном
# ответе прокси, реже упираемся в его лимит на батч. Дефолт: 30.
BITRIX_WINDOW_DAYS=
# Сколько временных окон получать параллельно при выборке компаний/сделок. Дефолт: 4.
BITRIX_FETCH_CONCURRENCY=
# Сколько запросов истории (по стадиям и по ответственным) выполнять параллельно. Дефолт: 8.
BITRIX_HISTORY_CONCURRENCY=
